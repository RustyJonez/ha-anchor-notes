{
  "entity": {
    "sensor": {
      "pending_reminders": {
        "default": "mdi:bell-outline"
      },
      "next_reminder": {
        "default": "mdi:bell-ring-outline"
      },
      "pinned_notes": {
        "default": "mdi:pin"
      },
      "recent_created": {
        "default": "mdi:note-plus-outline"
      },
      "recent_edited": {
        "default": "mdi:note-edit-outline"
      },
      "note_view": {
        "default": "mdi:note-search-outline"
      }
    },
    "select": {
      "recent_view": {
        "default": "mdi:swap-horizontal"
      }
    }
  },
  "services": {
    "show_note": {
      "service": "mdi:note-search-outline"
    },
    "clear_note": {
      "service": "mdi:note-remove-outline"
    }
  }
}
